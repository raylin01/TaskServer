<!DOCTYPE html>
<html>
<head>
  <title>TaskServer - Scripts</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('partials/nav') %>
  <main>
    <h2>Scripts</h2>
    <% if (!pm2Available) { %>
      <p class="status status-stopped">PM2 is not reachable, so job states are unknown. Try again in a moment.</p>
    <% } %>
    <table>
      <thead>
        <tr>
          <th>Name</th><th>Type</th><th>Source</th><th>Schedule</th><th>Status</th><th>Actions</th><th>Logs</th>
        </tr>
      </thead>
      <tbody>
        <% scripts.forEach(script => { %>
          <tr>
            <td><strong><%= script.name %></strong></td>
            <td><span class="badge badge-<%= script.type %>"><%= script.type %></span></td>
            <td>
              <% if (script.command) { %>
                <span title="<%= script.command %>" style="font-family: monospace; font-size: 0.85em;">
                  💻 <%= script.command.length > 40 ? script.command.substring(0, 40) + '...' : script.command %>
                </span>
              <% } else { %>
                <span title="<%= script.path %>" style="font-family: monospace; font-size: 0.85em;">
                  📄 <%= script.path %>
                </span>
              <% } %>
            </td>
            <td><%= script.schedule || '-' %></td>
            <td>
              <% if (script.type === 'cron') { %>
                <% const cronHistory = cronRunHistory[script.name]; %>
                <% const isSuspended = cronSuspended && cronSuspended[script.name]; %>
                <% if (isSuspended) { %>
                  <span class="status status-stopped">Suspended</span>
                <% } else if (cronHistory && cronHistory.lastRun) { %>
                  <span class="status status-cron">
                    Last run: <%= new Date(cronHistory.lastRun).toLocaleString() %><%= cronHistory.lastTrigger === 'manual' ? ' (manual)' : '' %>
                  </span>
                <% } else { %>
                  <span class="status status-pending">Last run: None</span>
                <% } %>
              <% } else { %>
                <% const state = jobStates[script.name]; %>
                <% if (state.status === 'stopped') { %>
                  <span class="status status-stopped">Stopped</span>
                <% } else { %>
                  <span class="status status-<%= state.status.replace(/\s+/g, '-') %>"><%= state.status %></span>
                  <% if (state.drift) { %>
                    <br><small title="The config says this job is stopped, but PM2 has it running. Press Stop to stop it for good.">marked stopped in config</small>
                  <% } %>
                <% } %>
              <% } %>
            </td>
            <td class="actions">
              <% if (script.type === 'cron') { %>
                <% const isSuspended = cronSuspended && cronSuspended[script.name]; %>
                <% if (isSuspended) { %>
                  <form method="post" action="/resume-cron/<%= encodeURIComponent(script.name) %>" style="display:inline">
                    <%- include('partials/csrf-field') %>
                    <button type="submit" class="btn-action btn-start" title="Resume">
                      <span class="icon">▶</span>
                    </button>
                  </form>
                <% } else { %>
                  <form method="post" action="/suspend-cron/<%= encodeURIComponent(script.name) %>" style="display:inline">
                    <%- include('partials/csrf-field') %>
                    <button type="submit" class="btn-action btn-stop" title="Suspend">
                      <span class="icon">■</span>
                    </button>
                  </form>
                <% } %>
                <form method="post" action="/run-cron-now/<%= encodeURIComponent(script.name) %>" style="display:inline">
                  <%- include('partials/csrf-field') %>
                  <button type="submit" class="btn-action btn-run-now" title="Run Now">
                    <span class="icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M8 6.5V4a1 1 0 0 1 2 0v2.5a1 1 0 0 1-2 0ZM14 4a1 1 0 1 1 2 0v2.5a1 1 0 1 1-2 0V4Zm-7.25 7A1.75 1.75 0 0 0 5 12.75v5.5C5 19.216 5.784 20 6.75 20h10.5A1.75 1.75 0 0 0 19 18.25v-5.5A1.75 1.75 0 0 0 17.25 11H6.75ZM3 12.75A3.75 3.75 0 0 1 6.75 9h10.5A3.75 3.75 0 0 1 21 12.75v5.5A3.75 3.75 0 0 1 17.25 22H6.75A3.75 3.75 0 0 1 3 18.25v-5.5Zm8.25 1.19a1 1 0 0 1 1.5.86v1.496l1.633.942a1 1 0 0 1-1 1.732l-2.133-1.232a1 1 0 0 1-.5-.866V14.8a1 1 0 0 1 .5-.86Z"></path>
                      </svg>
                    </span>
                  </button>
                </form>
              <% } else { %>
                <% const isStopped = !jobStates[script.name].running; %>
                <% if (isStopped) { %>
                  <form method="post" action="/start-script/<%= encodeURIComponent(script.name) %>" style="display:inline">
                    <%- include('partials/csrf-field') %>
                    <button type="submit" class="btn-action btn-start" title="Start">
                      <span class="icon">▶</span>
                    </button>
                  </form>
                <% } else { %>
                  <form method="post" action="/stop-script/<%= encodeURIComponent(script.name) %>" style="display:inline">
                    <%- include('partials/csrf-field') %>
                    <button type="submit" class="btn-action btn-stop" title="Stop">
                      <span class="icon">■</span>
                    </button>
                  </form>
                <% } %>
                <form method="post" action="/restart-script/<%= encodeURIComponent(script.name) %>" style="display:inline">
                  <%- include('partials/csrf-field') %>
                  <button type="submit" class="btn-action btn-restart" title="Restart">
                    <span class="icon">↻</span>
                  </button>
                </form>
              <% } %>
              <a href="/edit-script/<%= encodeURIComponent(script.name) %>" class="btn-action btn-edit" title="Edit">
                <span class="icon">✎</span>
              </a>
              <form method="post" action="/delete-script/<%= encodeURIComponent(script.name) %>" style="display:inline" data-confirm-delete="<%= script.name %>">
                <%- include('partials/csrf-field') %>
                <button type="submit" class="btn-action btn-delete" title="Delete">
                  <span class="icon">✕</span>
                </button>
              </form>
            </td>
            <td><a href="/logs/<%= encodeURIComponent(script.name) %>" class="btn-link">
              <span class="icon">☰</span> View Logs
            </a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
  <footer>
    <small>&copy; 2025 TaskServer</small>
  </footer>
  <script src="/confirm-delete.js"></script>
</body>
</html>
