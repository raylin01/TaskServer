<!DOCTYPE html>
<html>
<head>
  <title>TaskServer - Add Script</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('partials/nav') %>
  <main>
    <h2>Add New Script</h2>
    <form method="post" action="/add-script" class="script-form">
      <%- include('partials/csrf-field') %>
      <div class="form-group">
        <label for="name">Script Name <span class="required">*</span></label>
        <input type="text" id="name" name="name" required placeholder="e.g., myScript">
        <small>Unique identifier for this script</small>
      </div>

      <div class="form-group">
        <label for="sourceType">Script Source <span class="required">*</span></label>
        <select id="sourceType" name="sourceType">
          <option value="file">Script File</option>
          <option value="command">Command Line</option>
        </select>
        <small id="sourceTypeHelp">Run a script file from disk</small>
      </div>

      <div class="form-group" id="pathGroup">
        <label for="path">Script Path <span class="required">*</span></label>
        <input type="text" id="path" name="path" placeholder="e.g., ./scripts/myScript.js">
        <small>Relative or absolute path to your script file</small>
      </div>

      <div class="form-group" id="commandGroup" style="display: none;">
        <label for="command">Command <span class="required">*</span></label>
        <input type="text" id="command" name="command" placeholder="e.g., curl -X POST https://api.example.com/webhook">
        <small>Any shell command to execute (e.g., curl, wget, echo, custom scripts)</small>
      </div>

      <div class="form-group">
        <label for="cwd">Working Directory (optional)</label>
        <input type="text" id="cwd" name="cwd" placeholder="e.g., ~/Documents/test or ./scripts">
        <small>Recommended for commands like <code>bun start</code> so you do not need <code>cd ... &&</code>. Supports <code>~</code> home paths.</small>
      </div>

      <div class="form-group">
        <label for="type">Execution Type <span class="required">*</span></label>
        <select id="type" name="type">
          <option value="forever">Forever (Always Running)</option>
          <option value="cron">Cron (Scheduled)</option>
        </select>
        <small id="typeHelp">Script will run continuously and restart on crash</small>
      </div>

      <div id="cronOptions" style="display: none;">
        <%- include('partials/cron-builder', { schedule: '* * * * *', count: '', serverTimeZone: typeof serverTimeZone !== 'undefined' ? serverTimeZone : 'Local server time' }) %>
      </div>

      <div class="form-group">
        <label for="args">Arguments (optional)</label>
        <input type="text" id="args" name="args" placeholder="--flag1, value1, --flag2, value2">
        <small>Comma-separated list of arguments to pass to the script</small>
      </div>

      <div class="form-group">
        <label for="env">Environment Variables (optional)</label>
        <textarea id="env" name="env" rows="3" placeholder='{"KEY1": "value1", "KEY2": "value2"}'>{}</textarea>
        <small>JSON object of environment variables</small>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-primary">Add Script</button>
        <a href="/scripts" class="btn-secondary">Cancel</a>
      </div>
    </form>
  </main>
  <footer>
    <small>&copy; 2025 TaskServer</small>
  </footer>

  <script src="/cron-builder.js"></script>
  <script src="/script-form.js"></script>
</body>
</html>
